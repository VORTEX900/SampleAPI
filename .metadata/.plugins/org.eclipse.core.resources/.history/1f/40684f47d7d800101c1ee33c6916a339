package com.medialogic.service;
import java.time.LocalDate;
import java.time.Period;
import java.util.Map;

import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;
import org.springframework.stereotype.Service;

import com.medialogic.bean.CfResponse;

@Service
public class ElaborateCFService {

	Logger log = LogManager.getLogger(ElaborateCFService.class);
	
	/**
	 * 
	 * REGOLA =
	 * 1–3   → cognome (consonanti, poi vocali)
	 * 4–6   → nome (consonanti, poi vocali)
	 * 7–8   → anno di nascita (ultime 2 cifre)
	 * 9     → mese (lettera)
	 * 10–11 → giorno di nascita +40 se femmina
	 * 12–15 → codice del comune (lettera + 3 cifre)
	 * 16    → carattere di controllo
	 * 
	 * @param cf
	 * @return
	 */
	public CfResponse elaborateCF(String cf) {
		return parseCF(cf);
	}
	
	private static final Map<Character, Integer> MESE_MAP = Map.ofEntries(
	        Map.entry('A', 1),
	        Map.entry('B', 2),
	        Map.entry('C', 3),
	        Map.entry('D', 4),
	        Map.entry('E', 5),
	        Map.entry('H', 6),
	        Map.entry('L', 7),
	        Map.entry('M', 8),
	        Map.entry('P', 9),
	        Map.entry('R', 10),
	        Map.entry('S', 11),
	        Map.entry('T', 12)
	);
	
	private static CfResponse parseCF(String codiceFiscale) {

		int anno = Integer.parseInt(codiceFiscale.substring(6, 8));
	    int annoCompleto = resolveAnno(anno);

	    char meseChar = codiceFiscale.charAt(8);
	    Integer mese = MESE_MAP.get(meseChar);

	    int giorno = Integer.parseInt(codiceFiscale.substring(9, 11));
	    if (giorno > 40) {
	    	giorno -= 40;
	    }

	    LocalDate dataNascita = LocalDate.of(annoCompleto, mese, giorno);
	    int eta = Period.between(dataNascita, LocalDate.now()).getYears();
		return new CfResponse(dataNascita, eta);
	}

	private static int resolveAnno(int anno) {
		int annoCorrente = LocalDate.now().getYear() % 100;
	    int secolo = (anno <= annoCorrente) ? 2000 : 1900;
	    return secolo + anno;
	}

}
