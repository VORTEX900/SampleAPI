package com.medialogic.service;
import java.time.LocalDate;
import java.util.Map;

import org.springframework.stereotype.Service;

import com.medialogic.bean.CfResponse;

@Service
public class ElaborateCFService {

	public CfResponse elaborateCF(String cf) {
		CfResponse cfResponse = new CfResponse(); 
		
		cfResponse.setEta(35);
		cfResponse.setDataDiNascita(LocalDate.now());
		
		return cfResponse;
	}
	
	private static final Map<Character, Integer> MESE_MAP = Map.of(
	            'A', 1, 'B', 2, 'C', 3, 'D', 4,
	            'E', 5, 'H', 6, 'L', 7, 'M', 8,
	            'P', 9, 'R', 10, 'S', 11, 'T', 12
	);

	    public static Risultato parse(String codiceFiscale) {

	        if (codiceFiscale == null || codiceFiscale.length() < 11) {
	            throw new IllegalArgumentException("Codice fiscale non valido");
	        }

	        // ANNO
	        int anno = Integer.parseInt(codiceFiscale.substring(6, 8));
	        int annoCompleto = resolveAnno(anno);

	        // MESE
	        char meseChar = codiceFiscale.charAt(8);
	        Integer mese = MESE_MAP.get(meseChar);
	        if (mese == null) {
	            throw new IllegalArgumentException("Mese non valido");
	        }

	        // GIORNO
	        int giorno = Integer.parseInt(codiceFiscale.substring(9, 11));
	        if (giorno > 40) {
	            giorno -= 40; // femmina
	        }

	        LocalDate dataNascita = LocalDate.of(annoCompleto, mese, giorno);
	        int eta = Period.between(dataNascita, LocalDate.now()).getYears();

	        return new Risultato(dataNascita, eta);
	    }

	    private static int resolveAnno(int anno) {
	        int annoCorrente = LocalDate.now().getYear() % 100;
	        int secolo = (anno <= annoCorrente) ? 2000 : 1900;
	        return secolo + anno;
	    }

	    public record Risultato(LocalDate dataNascita, int eta) {}
	
}
