package com.medialogic.controller;

import java.util.Map;

import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.medialogic.bean.CfRequest;
import com.medialogic.bean.CfResponse;
import com.medialogic.service.ElaborateCFService;

import jakarta.validation.Valid;

@RestController
@RequestMapping("/home")
public class SampleAPIController {
	
	Logger log = LogManager.getLogger(SampleAPIController.class);
	
	private final ElaborateCFService elaborateCFService;
	
	public SampleAPIController(ElaborateCFService elaborateCFService) {
		this.elaborateCFService = elaborateCFService;
	}
	
	@GetMapping("/serverCheck")
	public ResponseEntity<Void> serverCheck(){
		return ResponseEntity.ok().build();
	}
	
	@PostMapping("/elaborateCF")
	public ResponseEntity<Map<String, CfResponse>> elaborateCF(@Valid @RequestBody CfRequest cfRequest){
		log.info("Start SampleAPIController >>> elaborateCF");
		
		String cf = cfRequest.getCf();
		
		CfResponse ret = elaborateCFService.elaborateCF(cf);
		
		log.info("SampleAPIController >>> elaborateCF");
		
		return ResponseEntity.ok(Map.of("message", ret));
		
	}

}
