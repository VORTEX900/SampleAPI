package com.medialogic.bean;

import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.Pattern;
import jakarta.validation.constraints.Size;
import lombok.Getter;
import lombok.Setter;

@Getter
@Setter
public class CfRequest {
	
	@Size(min = 16, max = 16, message = "cf must be 16 characters long")
	@NotBlank(message = "cf is mandatory")
	@Pattern(
		regexp = "^[A-Z]{6}[0-9]{2}[A-EHLMPR-T][0-9]{2}[A-Z][0-9]{3}[A-Z]$",
		message = "cf format is invalid"
	)
	private String cf;

}
